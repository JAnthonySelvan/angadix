# Render Production Environment Variables for Angadix Backend

# 1. Server Setup
PORT=5000
NODE_ENV=production
CLIENT_URL=https://angadix.vercel.app
CLIENT_URLS=https://angadix.vercel.app,http://localhost:3000

# 2. Database Connection (MongoDB Atlas)
MONGO_URI=mongodb+srv://<db_user>:<db_password>@cluster0.mongodb.net/angadix?retryWrites=true&w=majority

# 3. JWT Security Tokens (Use strong random strings)
JWT_ACCESS_SECRET=your_production_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_production_jwt_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# 4. Cross-Domain Cookie Settings
COOKIE_SAME_SITE=none
COOKIE_SECURE=true

# 5. Email Service Credentials (Optional - Nodemailer/Resend/SendGrid)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
SMTP_FROM="Angadix Store <noreply@angadix.com>"

# 6. Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://angadix.vercel.app

# 7. Cloudinary Media Storage (Optional)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 8. Razorpay Payment Gateway (Optional)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
